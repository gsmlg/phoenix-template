<Layouts.app flash={@flash}>
  <section class="bg-primary text-primary-content">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:py-28">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-primary-content/75">Phoenix application starter</p>
        <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
          A clear foundation for your next web system.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-primary-content/80">
          Phoenix 1.8, LiveView 1.2, Bandit, and DuskMoon are wired together so your team can start building product workflows immediately.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://hexdocs.pm/phoenix/overview.html" class="btn btn-secondary">
            Read Phoenix docs
          </a>
          <a href="https://github.com/gsmlg/phoenix-template" class="btn btn-outline border-primary-content/50 text-primary-content hover:bg-primary-content/10">
            View source
          </a>
        </div>
      </div>
      <div class="rounded-2xl bg-primary-container p-6 text-on-primary-container shadow-xl">
        <div class="mb-6 flex items-center justify-between">
          <span class="text-sm font-semibold">Included by default</span>
          <span class="badge badge-primary">ready</span>
        </div>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3"><span class="mt-0.5 size-2 rounded-full bg-primary"></span><span>Verified routes and modern HTML components</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 size-2 rounded-full bg-primary"></span><span>Tailwind 4 assets through DuskMoonBundler</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 size-2 rounded-full bg-primary"></span><span>Theme-aware UI with sunshine and moonlight</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 size-2 rounded-full bg-primary"></span><span>Igniter available for project extensions</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Design system</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">Surfaces that keep product work legible.</h2>
      <p class="mt-4 text-on-surface-variant">
        Use DuskMoon tokens for hierarchy, semantic states, and accessible contrast instead of inventing one-off colors for every page.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-xl border border-outline-variant bg-surface-container p-6">
        <.dm_mdi name="view-dashboard-outline" class="mb-5 size-7 text-primary" />
        <h3 class="text-lg font-semibold">Operational layouts</h3>
        <p class="mt-2 text-sm leading-6 text-on-surface-variant">A restrained app shell gives dashboards, forms, and tables room to stay scannable.</p>
      </article>
      <article class="rounded-xl border border-outline-variant bg-surface-container p-6">
        <.dm_mdi name="lightning-bolt-outline" class="mb-5 size-7 text-secondary" />
        <h3 class="text-lg font-semibold">Fast feedback</h3>
        <p class="mt-2 text-sm leading-6 text-on-surface-variant">LiveView and the standard flash group are ready for navigation, validation, and reconnect states.</p>
      </article>
      <article class="rounded-xl border border-outline-variant bg-surface-container p-6">
        <.dm_mdi name="palette-outline" class="mb-5 size-7 text-tertiary" />
        <h3 class="text-lg font-semibold">Theme tokens</h3>
        <p class="mt-2 text-sm leading-6 text-on-surface-variant">Switch between sunshine and moonlight without coupling templates to hardcoded colors.</p>
      </article>
    </div>
  </section>
</Layouts.app>
