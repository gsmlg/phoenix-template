<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]" data-theme="sunshine">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23e99a00'/%3E%3Cpath d='M9 8h4v16H9zm10 0h4v16h-4z' fill='white'/%3E%3C/svg%3E" />
    <.live_title default="Phoenix Template" suffix=" · Phoenix">
      {assigns[:page_title]}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={DuskmoonBundler.static_path(GsmlgWeb.Endpoint, "/assets/css/app.css", profile: :gsmlg)}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={DuskmoonBundler.static_path(GsmlgWeb.Endpoint, "/assets/js/app.js", profile: :gsmlg)}
    ></script>
    <script>
      (() => {
        const theme = localStorage.getItem("theme");
        if (theme && theme !== "default") document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="bg-surface text-on-surface antialiased">
    {@inner_content}
  </body>
</html>
